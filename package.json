{
  "name": "speed-tiptap-editor",
  "version": "0.1.0",
  "description": "基于 Ant Design Vue + Tiptap 的富文本编辑器",
  "main": "example/main.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:example",
    "build:lib": "cross-env BUILD_MODE=lib vite build",
    "build:example": "vite build --outDir dist-example",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build:deploy": "npm run build:example && npm run docs:build && node scripts/prepare-deploy.js",
    "test": "vitest",
    "lint": "eslint src example --ext .ts,.tsx,.vue",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue}\" \"example/**/*.{ts,tsx,vue}\"",
    "prepare": "husky install"
  },
  "keywords": [
    "vue",
    "components",
    "ant-design-vue",
    "hooks",
    "utils"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/highlight.js": "^10.1.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.11.0",
    "@unocss/vite": "^0.58.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "@vue/compiler-sfc": "^3.4.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.5.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "eslint-plugin-vue": "^9.21.0",
    "fs-extra": "^11.3.0",
    "husky": "^9.0.0",
    "interactjs": "^1.10.17",
    "less": "^4.2.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "unocss": "^0.58.0",
    "unplugin-vue-components": "^28.7.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.0.0",
    "vitest": "^1.2.0",
    "vue-tsc": "^1.8.0"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.0",
    "@floating-ui/dom": "^1.6.0",
    "@highlightjs/vue-plugin": "^2.1.2",
    "@hocuspocus/provider": "^1.0.0-beta.4",
    "@tiptap/core": "3.0.6",
    "@tiptap/extension-blockquote": "^3.0.6",
    "@tiptap/extension-bubble-menu": "^3.0.6",
    "@tiptap/extension-code": "^3.0.0",
    "@tiptap/extension-code-block": "^3.0.0",
    "@tiptap/extension-code-block-lowlight": "^3.0.0",
    "@tiptap/extension-collaboration": "^3.0.0",
    "@tiptap/extension-collaboration-cursor": "^3.0.0",
    "@tiptap/extension-color": "^3.0.0",
    "@tiptap/extension-document": "^3.0.0",
    "@tiptap/extension-emoji": "^3.0.0",
    "@tiptap/extension-file-handler": "^3.4.0",
    "@tiptap/extension-gapcursor": "^3.0.0",
    "@tiptap/extension-horizontal-rule": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-link": "^3.0.0",
    "@tiptap/extension-list": "^3.0.0",
    "@tiptap/extension-mention": "^3.0.0",
    "@tiptap/extension-paragraph": "^3.0.0",
    "@tiptap/extension-subscript": "^3.0.6",
    "@tiptap/extension-superscript": "^3.0.6",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-text": "^3.0.0",
    "@tiptap/extension-text-align": "^3.0.0",
    "@tiptap/extension-text-style": "^3.0.0",
    "@tiptap/extension-underline": "^3.0.0",
    "@tiptap/extensions": "^3.0.6",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/suggestion": "^3.0.6",
    "@tiptap/vue-3": "3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@vueuse/core": "^13.1.0",
    "ant-design-vue": "^4.1.0",
    "axios": "^0.27.2",
    "dompurify": "^3.2.6",
    "es-drager": "1.2.11",
    "highlight.js": "^11.11.1",
    "lodash-es": "^4.17.21",
    "lowlight": "^3.3.0",
    "markdown-it": "^14.1.0",
    "pinia": "^3.0.3",
    "scroll-into-view-if-needed": "^3.0.3",
    "speed-components-ui": "^0.1.26",
    "toggle-selection": "^1.0.6",
    "viewerjs": "^1.11.7",
    "vitepress": "^1.0.0",
    "vue-collapsed": "^1.3.4",
    "vue-color": "^3.2.0",
    "vue-router": "^4.5.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whateveryoudo/speed-tiptap-editor.git"
  },
  "bugs": {
    "url": "https://github.com/whateveryoudo/speed-tiptap-editor/issues"
  },
  "homepage": "https://github.com/whateveryoudo/speed-tiptap-editor#readme"
}

{
  "name": "speed-tiptap-editor",
  "version": "1.0.0",
  "description": "基于 Ant Design Vue + Tiptap 的富文本编辑器",
  "main": "example/main.ts",
  "exports": {
    ".": {
      "import": "./dist/speed-tiptap-editor-index.es.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:example",
    "build:lib": "cross-env BUILD_MODE=lib vite build",
    "build:example": "vite build --outDir dist-example",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build:deploy": "npm run build:example && npm run docs:build && node scripts/prepare-deploy.js",
    "test": "vitest",
    "lint": "eslint src example --ext .ts,.tsx,.vue",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue}\" \"example/**/*.{ts,tsx,vue}\"",
    "prepare": "husky install"
  },
  "keywords": [
    "vue",
    "vue3",
    "tiptap",
    "editor",
    "rich-text-editor",
    "rich-text",
    "text-editor",
    "ai-editor",
    "speed-knowledge-base",
    "speed-editor",
    "speed-tiptap-editor",
    "components",
    "ant-design-vue",
    "hooks",
    "utils"
  ],
  "author": "",
  "license": "MIT",

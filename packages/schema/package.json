    "@tiptap/core": "^3.0.6"
  },
  "devDependencies": {
    "@tiptap/core": "^3.0.6",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@speed-tiptap-editor/knowledge-editor",
  "version": "2.0.3",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.less",
    "dist/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@speed-tiptap-editor/base-editor": "workspace:^",
    "@speed-tiptap-editor/collaboration-editor": "workspace:^",
    "@speed-tiptap-editor/extension-flow": "workspace:^",
    "@speed-tiptap-editor/extension-import-export": "workspace:^",
    "@speed-tiptap-editor/extension-kit": "workspace:^",
    "@speed-tiptap-editor/extension-mind": "workspace:^",
    "@speed-tiptap-editor/kit-base": "workspace:^",
    "@speed-tiptap-editor/shared": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.0.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
